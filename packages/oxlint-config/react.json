{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["./base.json"],
  "plugins": ["react", "react-perf", "jsx-a11y"],
  "env": {
    "builtin": true,
    "browser": true
  },
  "rules": {
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "react/react-in-jsx-scope": "off"
  }
}
