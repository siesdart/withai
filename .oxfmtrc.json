{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "sortImports": {},
  "sortPackageJson": {},
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles/globals.css",
    "functions": ["clsx", "cn", "cva", "tw"]
  },
  "ignorePatterns": [
    "**/apm_modules",
    "**/node_modules",
    "**/.agents",
    "**/docs",
    "**/dist",
    "**/apm.lock.yaml",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/*.gen.*"
  ]
}
