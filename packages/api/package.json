{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/entry.js",
      "require": "./dist/entry.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "main": "./dist/entry.js",
  "types": "./dist/entry.d.ts",
  "files": [
    "./dist/**"
  ],
  "scripts": {
    "build": "tsc -b -v",
    "dev": "pnpm build --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/mapped-types": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
