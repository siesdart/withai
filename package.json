{
  "name": "withai",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up -d --wait redis && REDIS_URL=\"${REDIS_URL:-redis://127.0.0.1:6379}\" turbo run dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.11"
  },
  "packageManager": "pnpm@11.5.1"
}
